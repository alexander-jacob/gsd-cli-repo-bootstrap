#!/usr/bin/env python3
"""GSD Core CLI launcher: subscription-backed model and reviewer profiles.

Commands:
  gsd-cli init [claude|codex]
  gsd-cli status
  gsd-cli codex plan [--secure] [-- CLI_ARGS...]
  gsd-cli claude plan [-- CLI_ARGS...]
  gsd-cli claude exec-opus|exec-sonnet [--secure] [-- CLI_ARGS...]
  gsd-cli codex exec-high|exec-medium|exec-low [--secure] [-- CLI_ARGS...]
  gsd-cli codex|claude review-codex-plan|review-claude-plan [-- CLI_ARGS...]

Run within a GSD project (or a subdirectory). Config changes are atomic and
limited to the explicit policy keys. Execution profiles preserve reviewers.
Every launch materializes per-agent tier pins (AGENT_TIERS) into
model_overrides for the launched runtime; other override keys are kept.
Execution profiles and Codex planning skip runtime permission checks by default
(Codex also disables sandboxing); --secure keeps the CLI's permission prompts
instead. Claude planning and review profiles always keep them.
Codex sessions also get -c model_reasoning_effort=<tier effort> for the
session model (Astra high, Sol medium, Luna low); Codex otherwise defaults
Astra to medium. Claude Code has no equivalent launch flag.
"""

import json
import os
import stat
import sys
import tempfile
from pathlib import Path

# Claude subagents are spawned through Claude Code's Agent tool, which accepts
# only the aliases fable/opus/sonnet/haiku (resolved to the latest model of each
# family), never full model IDs. GSD drops a full ID it cannot map back to an
# alias and the subagent silently inherits the session model instead.
CLAUDE_MODELS = {
    "opus": {"model": "fable"},
    "sonnet": {"model": "opus"},
    "haiku": {"model": "sonnet"},
}
CODEX_MODELS = {
    "opus": {"model": "gpt-6-astra", "reasoning_effort": "high"},
    "sonnet": {"model": "gpt-6.1-sol", "reasoning_effort": "medium"},
    "haiku": {"model": "gpt-6-luna", "reasoning_effort": "low"},
}
REVIEWERS = {
    "fable-review": {"cli": "claude", "model": "claude-fable-5-1"},
    "astra-review": {"cli": "codex", "model": "gpt-6-astra"},
    "grok-review": {"cli": "opencode", "model": "openrouter/x-ai/grok-4.7"},
    "gemini-review": {"cli": "opencode", "model": "openrouter/google/gemini-4-argon"},
    "deepseek-review": {"cli": "opencode", "model": "openrouter/deepseek/deepseek-v3.2"},
}
OTHER_REVIEWERS = ["grok-review", "gemini-review", "deepseek-review"]

# Per-agent tier pins for agents whose GSD phase type is broader than the job:
# mechanical research/verification agents that would otherwise ride the high
# tier. Keyed by GSD tier so one table serves both runtimes; a launch
# materializes it into model_overrides for the launched runtime (Claude needs
# Agent-tool aliases, Codex needs full IDs, and GSD applies the value verbatim).
# Agents absent here follow models.<phase_type> / the model profile.
AGENT_TIERS = {
    # execution-shaped verification / planning helpers -> medium tier
    "gsd-nyquist-auditor": "sonnet",
    "gsd-integration-checker": "sonnet",
    "gsd-pattern-mapper": "sonnet",
    "gsd-doc-verifier": "sonnet",
    "gsd-research-synthesizer": "sonnet",
    # bulk extraction / bookkeeping -> lower tier
    "gsd-codebase-mapper": "haiku",
    "gsd-intel-updater": "haiku",
    "gsd-doc-classifier": "haiku",
    "gsd-user-profiler": "haiku",
    "gsd-mempalace-curator": "haiku",
}
CODEX_PLAN_REVIEWERS = ["fable-review", *OTHER_REVIEWERS]
CLAUDE_PLAN_REVIEWERS = ["astra-review", *OTHER_REVIEWERS]

# (runtime, profile) -> (top-level session model, phase overrides, reviewer preset)
# Claude execution profiles pin verification (code review + verifier) to the
# high tier so the review runs on Fable regardless of the execution tier.
PROFILES = {
    ("codex", "plan"): ("gpt-6-astra", {"planning": "opus", "discuss": "opus", "research": "opus"}, CODEX_PLAN_REVIEWERS),
    ("claude", "plan"): ("claude-fable-5-1", {"planning": "opus", "discuss": "opus", "research": "opus"}, CLAUDE_PLAN_REVIEWERS),
    ("claude", "exec-opus"): ("claude-opus-5-5", {"execution": "sonnet", "verification": "opus"}, None),
    ("claude", "exec-sonnet"): ("claude-sonnet-5-5", {"execution": "haiku", "verification": "opus"}, None),
    ("codex", "exec-high"): ("gpt-6-astra", {"execution": "opus"}, None),
    ("codex", "exec-medium"): ("gpt-6.1-sol", {"execution": "sonnet"}, None),
    ("codex", "exec-low"): ("gpt-6-luna", {"execution": "haiku"}, None),
    ("codex", "review-codex-plan"): ("gpt-6-astra", {}, CODEX_PLAN_REVIEWERS),
    ("claude", "review-codex-plan"): ("claude-fable-5-1", {}, CODEX_PLAN_REVIEWERS),
    ("codex", "review-claude-plan"): ("gpt-6-astra", {}, CLAUDE_PLAN_REVIEWERS),
    ("claude", "review-claude-plan"): ("claude-opus-5-5", {}, CLAUDE_PLAN_REVIEWERS),
}


def usage() -> None:
    print(__doc__.strip(), file=sys.stderr)


def project_config() -> Path:
    for directory in (Path.cwd(), *Path.cwd().parents):
        path = directory / ".planning" / "config.json"
        if path.is_file():
            return path
    sys.exit("Error: .planning/config.json not found; run in a GSD project.")


def load(path: Path) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        sys.exit(f"Cannot read {path}: {exc}")
    if not isinstance(data, dict):
        sys.exit("Error: .planning/config.json must contain a JSON object")
    return data


def save(path: Path, data: dict) -> None:
    # Atomic replace: avoid partially written JSON when launching several CLIs.
    content = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    old = path.read_text(encoding="utf-8")
    if content == old:
        return
    fd, filename = tempfile.mkstemp(prefix=".gsd-config-", dir=path.parent)
    try:
        os.fchmod(fd, stat.S_IMODE(path.stat().st_mode))
        with os.fdopen(fd, "w", encoding="utf-8") as file:
            file.write(content)
            file.flush()
            os.fsync(file.fileno())
        os.replace(filename, path)
    finally:
        if os.path.exists(filename):
            os.unlink(filename)


def initialize(data: dict, runtime: str = "claude") -> None:
    # Merge only our policy; keep other GSD settings and additional reviewers.
    policy = data.setdefault("model_policy", {})
    policy["provider"] = "generic"
    policy.setdefault("runtime_tiers", {}).update({
        "claude": CLAUDE_MODELS,
        "codex": CODEX_MODELS,
    })
    models = data.setdefault("models", {})
    models.setdefault("planning", "opus")
    models.setdefault("discuss", "opus")
    models.setdefault("research", "opus")
    models.setdefault("execution", "sonnet")
    models.setdefault("verification", "opus")
    # Pins are runtime-specific; seed them for `runtime` (any launch rewrites them).
    materialize_agent_tiers(data, runtime)
    review = data.setdefault("review", {})
    review.setdefault("reviewer_instances", {}).update(REVIEWERS)
    review.setdefault("default_reviewers", CODEX_PLAN_REVIEWERS.copy())
    review.setdefault("parallel_lanes", False)
    # Don't pin a project runtime: GSD_RUNTIME is set per launched session.
    data.pop("runtime", None)


def session_effort_args(runtime: str, session_model: str) -> list[str]:
    """Codex CLI args pinning the reasoning effort of the session model's tier."""
    if runtime != "codex":
        return []
    for entry in CODEX_MODELS.values():
        if entry["model"] == session_model:
            return ["-c", f"model_reasoning_effort={entry['reasoning_effort']}"]
    return []


def materialize_agent_tiers(data: dict, runtime: str) -> None:
    """Write AGENT_TIERS into model_overrides using the runtime's tier map."""
    tiers = data.get("model_policy", {}).get("runtime_tiers", {}).get(runtime, {})
    overrides = data.get("model_overrides") or {}
    for agent, tier in AGENT_TIERS.items():
        overrides[agent] = tiers[tier]["model"]
    data["model_overrides"] = overrides


def guard_subscription_billing(runtime: str, reviewers: list[str]) -> None:
    uses_claude = runtime == "claude" or "fable-review" in reviewers
    uses_codex = runtime == "codex" or "astra-review" in reviewers
    if uses_claude and os.environ.get("ANTHROPIC_API_KEY"):
        sys.exit("Refusing to launch: ANTHROPIC_API_KEY is set; unset it to use Claude Max authentication.")
    if uses_codex and (os.environ.get("OPENAI_API_KEY") or os.environ.get("CODEX_API_KEY")):
        sys.exit("Refusing to launch: OPENAI_API_KEY/CODEX_API_KEY is set; unset it to use ChatGPT login.")


def main() -> None:
    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help", "help"}:
        usage()
        sys.exit(0 if len(sys.argv) >= 2 else 2)

    path = project_config()
    data = load(path)
    action = sys.argv[1]

    if action == "init":
        if len(sys.argv) > 3 or (len(sys.argv) == 3 and sys.argv[2] not in ("claude", "codex")):
            sys.exit("Usage: gsd-cli init [claude|codex]")
        init_runtime = sys.argv[2] if len(sys.argv) == 3 else "claude"
        initialize(data, init_runtime)
        save(path, data)
        print(f"Initialized model tiers, phase tiers, {init_runtime} agent pins and five reviewer instances in {path}")
        return

    if action == "status":
        if len(sys.argv) != 2:
            sys.exit("Usage: gsd-cli status")
        print(json.dumps({
            "runtime": data.get("runtime", "(environment/marker)"),
            "models": data.get("models", {}),
            "model_overrides": data.get("model_overrides", {}),
            "runtime_tiers": data.get("model_policy", {}).get("runtime_tiers", {}),
            "default_reviewers": data.get("review", {}).get("default_reviewers"),
            "reviewer_instances": data.get("review", {}).get("reviewer_instances", {}),
        }, indent=2))
        return

    if len(sys.argv) < 3:
        usage()
        sys.exit(2)
    runtime, profile = sys.argv[1:3]
    key = (runtime, profile)
    if key not in PROFILES:
        usage()
        sys.exit(f"Unsupported runtime/profile: {runtime}/{profile}")

    args = sys.argv[3:]
    separator = args.index("--") if "--" in args else len(args)
    launcher_args, forwarded_args = args[:separator], args[separator + 1:]
    secure = "--secure" in launcher_args
    args = [arg for arg in launcher_args if arg != "--secure"] + forwarded_args
    if (profile.startswith("exec-") or key == ("codex", "plan")) and not secure:
        flag = ("--dangerously-skip-permissions" if runtime == "claude"
                else "--dangerously-bypass-approvals-and-sandbox")
        args.insert(0, flag)

    session_model, phase_changes, reviewers = PROFILES[key]
    review = data.get("review", {})
    if not all(name in review.get("reviewer_instances", {}) for name in REVIEWERS):
        sys.exit("Missing reviewer setup: run 'gsd-cli init' once first.")
    if not all(tier in data.get("model_policy", {}).get("runtime_tiers", {}).get(runtime, {})
               for tier in ("opus", "sonnet", "haiku")):
        sys.exit("Missing runtime tier setup: run 'gsd-cli init' once first.")

    chosen_reviewers = reviewers if reviewers is not None else review.get("default_reviewers", [])
    guard_subscription_billing(runtime, chosen_reviewers)

    data.setdefault("models", {}).update(phase_changes)
    materialize_agent_tiers(data, runtime)
    if reviewers is not None:
        review["default_reviewers"] = reviewers.copy()
    save(path, data)

    env = os.environ.copy()
    env["GSD_RUNTIME"] = runtime
    print(f"GSD: {runtime}/{profile} | model={session_model} | reviewers={','.join(chosen_reviewers)}", file=sys.stderr)
    os.chdir(path.parent.parent)
    try:
        argv = [runtime, "--model", session_model, *session_effort_args(runtime, session_model), *args]
        os.execvpe(runtime, argv, env)
    except FileNotFoundError:
        sys.exit(f"Cannot find CLI '{runtime}' on PATH")


if __name__ == "__main__":
    main()
