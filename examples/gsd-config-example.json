{
  "model_policy": {
    "provider": "generic",
    "runtime_tiers": {
      "claude": {
        "opus": {
          "model": "fable"
        },
        "sonnet": {
          "model": "opus"
        },
        "haiku": {
          "model": "sonnet"
        }
      },
      "codex": {
        "opus": {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        },
        "sonnet": {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "medium"
        },
        "haiku": {
          "model": "gpt-6-luna",
          "reasoning_effort": "low"
        }
      }
    }
  },
  "models": {
    "planning": "opus",
    "discuss": "opus",
    "research": "opus",
    "execution": "sonnet",
    "verification": "opus"
  },
  "review": {
    "reviewer_instances": {
      "fable-review": {
        "cli": "claude",
        "model": "claude-fable-5-1"
      },
      "astra-review": {
        "cli": "codex",
        "model": "gpt-6-astra"
      },
      "grok-review": {
        "cli": "opencode",
        "model": "openrouter/x-ai/grok-4.7"
      },
      "gemini-review": {
        "cli": "opencode",
        "model": "openrouter/google/gemini-4-argon"
      },
      "deepseek-review": {
        "cli": "opencode",
        "model": "openrouter/deepseek/deepseek-v3.2"
      }
    },
    "default_reviewers": [
      "fable-review",
      "grok-review",
      "gemini-review"
    ],
    "parallel_lanes": false
  },
  "model_overrides": {
    "gsd-nyquist-auditor": "opus",
    "gsd-integration-checker": "opus",
    "gsd-pattern-mapper": "opus",
    "gsd-doc-verifier": "opus",
    "gsd-research-synthesizer": "opus",
    "gsd-codebase-mapper": "sonnet",
    "gsd-intel-updater": "sonnet",
    "gsd-doc-classifier": "sonnet",
    "gsd-user-profiler": "sonnet",
    "gsd-mempalace-curator": "sonnet"
  }
}
