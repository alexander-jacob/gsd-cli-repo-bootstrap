{
  "model_policy": {
    "provider": "generic",
    "runtime_tiers": {
      "claude": {
        "opus": {
          "model": "claude-fable-5-1"
        },
        "sonnet": {
          "model": "claude-opus-5-5"
        },
        "haiku": {
          "model": "claude-sonnet-5-5"
        }
      },
      "codex": {
        "opus": {
          "model": "gpt-6-astra",
          "reasoning_effort": "high"
        },
        "sonnet": {
          "model": "gpt-6.1-sol",
          "reasoning_effort": "medium"
        },
        "haiku": {
          "model": "gpt-6-luna",
          "reasoning_effort": "low"
        }
      }
    }
  },
  "models": {
    "planning": "opus",
    "discuss": "opus",
    "execution": "sonnet"
  },
  "review": {
    "reviewer_instances": {
      "fable-review": {
        "cli": "claude",
        "model": "claude-fable-5-1"
      },
      "astra-review": {
        "cli": "codex",
        "model": "gpt-6-astra"
      },
      "grok-review": {
        "cli": "opencode",
        "model": "openrouter/x-ai/grok-4.7"
      },
      "gemini-review": {
        "cli": "opencode",
        "model": "openrouter/google/gemini-4-argon"
      },
      "deepseek-review": {
        "cli": "opencode",
        "model": "openrouter/deepseek/deepseek-v3.2"
      }
    },
    "default_reviewers": [
      "fable-review",
      "grok-review",
      "gemini-review",
      "deepseek-review"
    ],
    "parallel_lanes": false
  }
}
